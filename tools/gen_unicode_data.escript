#!/usr/bin/env escript
%% -*- erlang -*-
%%
%% Generate src/lex_unicode_data.erl from the Unicode Character Database.
%%
%% Usage:
%%   gen_unicode_data.escript UCD_DIR VERSION OUT_FILE
%%
%% UCD_DIR must contain (as laid out on unicode.org/Public/<ver>/ucd/):
%%   extracted/DerivedGeneralCategory.txt
%%   Scripts.txt  ScriptExtensions.txt  Blocks.txt
%%   PropList.txt  DerivedCoreProperties.txt
%%   PropertyAliases.txt  PropertyValueAliases.txt
%%
%% The generated module contains code point range lists only; all name
%% resolution logic lives in lex_unicode.erl. See `make unicode-data`.

-mode(compile).

main([Dir, Version, Out]) ->
    GC0 = group(read_ranges(Dir, "extracted/DerivedGeneralCategory.txt")),
    GC = add_gc_groups(GC0),
    ScriptsLong = group(read_ranges(Dir, "Scripts.txt")),
    PVA = read_fields(Dir, "PropertyValueAliases.txt"),
    ScAliases = [ Fs || ["sc" | Fs] <- PVA ],
    LongToShort = maps:from_list([ {Long, Short} || [Short, Long | _] <- ScAliases ]),
    Sc0 = maps:from_list([ {maps:get(Long, LongToShort), Rs}
                           || {Long, Rs} <- maps:to_list(ScriptsLong) ]),
    Sc = maps:put("Zzzz", complement(lists:append(maps:values(Sc0))), Sc0),
    Scx = script_extensions(Sc, read_ranges(Dir, "ScriptExtensions.txt")),
    Blk0 = group(read_ranges(Dir, "Blocks.txt")),
    Blk = maps:put("No_Block", complement(lists:append(maps:values(Blk0))),
                   maps:from_list([ {underscore(K), V} || {K, V} <- maps:to_list(Blk0) ])),
    Bin = group([ X || {_, _, _} = X <- read_ranges(Dir, "PropList.txt")
                           ++ read_ranges(Dir, "DerivedCoreProperties.txt") ]),
    PA = read_fields(Dir, "PropertyAliases.txt"),
    BinAliases = [ {Long, [Short, Long | Rest]}
                   || [Short, Long | Rest] <- PA, maps:is_key(Long, Bin) ],
    GcAliases = [ {Short, Fs} || ["gc" | Fs = [Short | _]] <- PVA ],
    ScAl = [ {Short, Fs} || [Short | _] = Fs <- ScAliases ],
    %% Blocks.txt says "Greek and Coptic", PropertyValueAliases.txt
    %% "Greek_And_Coptic": match the names loosely
    BlkByLoose = maps:from_list([ {loose(K), K} || K <- maps:keys(Blk) ]),
    BlkAliases = [ {maps:get(loose(Long), BlkByLoose), Fs}
                   || ["blk" | Fs = [_Short, Long | _]] <- PVA,
                      maps:is_key(loose(Long), BlkByLoose) ],
    Src = [header(Version),
           ranges_fun(gc, GC),
           ranges_fun(sc, Sc),
           ranges_fun(scx, Scx),
           ranges_fun(blk, Blk),
           ranges_fun(bin, Bin),
           alias_fun(gc, GcAliases, GC),
           alias_fun(sc, ScAl, Sc),
           alias_fun(blk, BlkAliases, Blk),
           alias_fun(bin, BinAliases, Bin)],
    ok = file:write_file(Out, Src),
    io:format("wrote ~s (Unicode ~s): ~p gc, ~p scripts, ~p blocks, ~p binary props~n",
              [Out, Version, maps:size(GC), maps:size(Sc), maps:size(Blk), maps:size(Bin)]);
main(_) ->
    io:format("usage: gen_unicode_data.escript UCD_DIR VERSION OUT_FILE~n"),
    halt(1).

%% ---------------------------------------------------------------------

header(Version) ->
    ["%% GENERATED by tools/gen_unicode_data.escript from the Unicode\n"
     "%% Character Database, version ", Version, ". DO NOT EDIT.\n"
     "%% Regenerate with `make unicode-data`.\n"
     "%%\n"
     "%% ranges(Kind, Canonical) -> [{From, To}] (sorted, disjoint, merged)\n"
     "%% canonical(Kind, LooseName) -> Canonical | undefined\n"
     "%%   Kind = gc | sc | scx | blk | bin\n"
     "%%   LooseName is lower case with ' ', '_', '-' removed (UAX44-LM3)\n\n"
     "-module(lex_unicode_data).\n"
     "-export([version/0, ranges/2, canonical/2]).\n\n"
     "version() -> \"", Version, "\".\n\n"].

ranges_fun(Kind, Map) ->
    [ io_lib:format("ranges(~p, ~p) ->~n    ~w;~n", [Kind, K, V])
      || {K, V} <- lists:sort(maps:to_list(Map)) ]
        ++ case Kind of
               bin -> "ranges(_, _) ->\n    undefined.\n\n";
               _ -> []
           end.

%% canonical(Kind, Loose) clauses. Kind sc also covers scx (same names).
alias_fun(Kind, Aliases, Map) ->
    Pairs = lists:usort([ {loose(A), Canon}
                          || {Canon, As} <- Aliases, maps:is_key(Canon, Map), A <- [Canon | As] ]),
    Clauses = [ io_lib:format("canonical(~p, ~p) -> ~p;~n", [Kind, L, C]) || {L, C} <- Pairs ],
    Tail = case Kind of
               sc -> "canonical(scx, L) -> canonical(sc, L);\n";
               bin -> "canonical(_, _) -> undefined.\n";
               _ -> ""
           end,
    [Clauses, Tail].

loose(S) ->
    string:lowercase([ C || C <- S, C =/= $\s, C =/= $_, C =/= $- ]).

underscore(S) -> [ case C of $\s -> $_; _ -> C end || C <- S ].

%% ---------------------------------------------------------------------
%% general category groups

add_gc_groups(GC) ->
    Groups = [{"L",  ["Lu", "Ll", "Lt", "Lm", "Lo"]},
              {"LC", ["Lu", "Ll", "Lt"]},
              {"M",  ["Mn", "Mc", "Me"]},
              {"N",  ["Nd", "Nl", "No"]},
              {"P",  ["Pc", "Pd", "Ps", "Pe", "Pi", "Pf", "Po"]},
              {"S",  ["Sm", "Sc", "Sk", "So"]},
              {"Z",  ["Zs", "Zl", "Zp"]},
              {"C",  ["Cc", "Cf", "Cs", "Co", "Cn"]}],
    lists:foldl(
      fun({G, Members}, Acc) ->
              maps:put(G, normalize(lists:append([ maps:get(M, GC, []) || M <- Members ])), Acc)
      end, GC, Groups).

%% Script_Extensions: scx(S) = cps with sc=S that have no scx entry,
%% plus cps whose scx entry lists S.
script_extensions(Sc, ScxEntries) ->
    WithEntry = normalize([ {F, T} || {_, F, T} <- ScxEntries ]),
    Base = maps:map(fun(_, Rs) -> subtract(Rs, WithEntry) end, Sc),
    Extra = lists:foldl(
              fun({Names, F, T}, Acc) ->
                      lists:foldl(fun(N, A) -> maps:update_with(N, fun(L) -> [{F, T} | L] end,
                                                                [{F, T}], A) end,
                                  Acc, string:lexemes(Names, " "))
              end, #{}, ScxEntries),
    maps:map(fun(K, Rs) -> normalize(Rs ++ maps:get(K, Extra, [])) end, Base).

%% ---------------------------------------------------------------------
%% file reading

%% Lines "XXXX[..YYYY] ; Value [# comment]" -> [{Value, From, To}]
read_ranges(Dir, File) ->
    [ begin
          [CPs, Val | _] = [ string:trim(F) || F <- string:split(L, ";", all) ],
          {F, T} = case string:split(CPs, "..") of
                       [A] -> {hex(A), hex(A)};
                       [A, B] -> {hex(A), hex(B)}
                   end,
          {Val, F, T}
      end || L <- data_lines(Dir, File),
             length(string:split(L, ";", all)) =:= 2 ].

read_fields(Dir, File) ->
    [ [ string:trim(F) || F <- string:split(L, ";", all) ] || L <- data_lines(Dir, File) ].

data_lines(Dir, File) ->
    {ok, Bin} = file:read_file(filename:join(Dir, File)),
    Lines = string:split(binary_to_list(Bin), "\n", all),
    [ L || L0 <- Lines,
           L <- [string:trim(hd(string:split(L0, "#")))],
           L =/= "" ].

hex(S) -> list_to_integer(S, 16).

group(Entries) ->
    M = lists:foldl(fun({V, F, T}, Acc) ->
                            maps:update_with(V, fun(L) -> [{F, T} | L] end, [{F, T}], Acc)
                    end, #{}, Entries),
    maps:map(fun(_, Rs) -> normalize(Rs) end, M).

%% ---------------------------------------------------------------------
%% range sets

normalize(Rs) -> merge(lists:sort(Rs)).

merge([{F1, T1}, {F2, T2} | Rs]) when F2 =< T1 + 1 -> merge([{F1, max(T1, T2)} | Rs]);
merge([R | Rs]) -> [R | merge(Rs)];
merge([]) -> [].

complement(Rs) -> compl(0, normalize(Rs)).

compl(M, [{F, T} | Rs]) when M < F -> [{M, F - 1} | compl(T + 1, Rs)];
compl(_, [{_, T} | Rs]) -> compl(T + 1, Rs);
compl(M, []) when M =< 16#10FFFF -> [{M, 16#10FFFF}];
compl(_, []) -> [].

subtract(A, B) -> intersect(A, complement(B)).

intersect([{F1, T1} | R1] = A, [{F2, T2} | R2] = B) ->
    F = max(F1, F2), T = min(T1, T2),
    Rest = if T1 < T2 -> intersect(R1, B); true -> intersect(A, R2) end,
    if F =< T -> [{F, T} | Rest]; true -> Rest end;
intersect(_, _) -> [].
